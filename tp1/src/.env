#!/usr/bin/env bash

#-------------------------------------------------------------------------------

VERBOSE=false
DEBUG=false
SETX=false
COMMAND_FLAGS=()
CBUILD_TARGET_DIR=""

#-------------------------------------------------------------------------------

CBUILD_ASSETS="$CBUILD_ROOT/assets"
CLI_ARGS="${@:2}" #Comandos após o segundo elemento da CLI
CBUILD_ALLOWED_CLI_FLAGS="vdx"
CBUILD_CLI_FLAGS_VARS_ARRAY=(
    VERBOSE
    DEBUG
    SETX
)
CBUILD_ALLOWED_CONFIG_VARS_ARRAY=(
    "$CBUILD_CLI_FLAGS_VARS_ARRAY[@]"
    COMMAND_FLAGS
)
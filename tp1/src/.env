#!/usr/bin/env bash

#-------------------------------------------------------------------------------

VERBOSE=false
DEBUG=false
SETX=false
COMMAND_FLAGS=()

#-------------------------------------------------------------------------------

CLI_ARGS="${@:2}"
CBUILD_TARGET_DIR=""
CBUILD_ASSETS="$CBUILD_ROOT/assets"

CBUILD_START_TIME=0
CBUILD_END_TIME=0
CBUILD_LOG_CODE=0
CBUILD_LOG_MESSAGE=""
CBUILD_LOG_COMMAND=""

CBUILD_ALLOWED_CLI_FLAGS="vdx"
CBUILD_CLI_FLAGS_VARS_ARRAY=(
    VERBOSE
    DEBUG
    SETX
)
CBUILD_ALLOWED_CONFIG_VARS_ARRAY=(
    "${CBUILD_CLI_FLAGS_VARS_ARRAY[@]}"
    COMMAND_FLAGS
)